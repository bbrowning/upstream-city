+    @pytest.mark.parametrize("suffix", [END_MESSAGE, END_SAMPLING])
+    def test_combined_parser_plain_text_drops_block_end(
+        self, mock_tokenizer, mock_request, suffix
+    ):
+        mock_request.tools = [{"type": "function", "function": {"name": "f"}}]
+        parser = _combined_parser(mock_tokenizer)
+        prompt_token_ids = [_TML_VOCAB[END_MESSAGE], _TML_VOCAB[MSG_MODEL]]
+        tokens = _tokenize(f"{TEXT_START}plain answer{suffix}")
+        content = ""
+
+        for index, (token_id, text) in enumerate(tokens):
+            delta = parser.parse_delta(
+                text,
+                [token_id],
+                mock_request,
+                prompt_token_ids=prompt_token_ids if index == 0 else None,
+                finished=index == len(tokens) - 1,
+            )
+            if delta and delta.content:
+                content += delta.content
+
+        assert content == "plain answer"
+
