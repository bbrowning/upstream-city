{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gascity.local/schemas/dev-pack-plan-result.schema.json",
  "title": "dev-pack plan result",
  "type": "object",
  "required": ["schema_version", "source", "changed", "dry_run", "cleared", "plan", "message"],
  "properties": {
    "schema_version": {"const": "dev-pack-plan.v1"},
    "source": {"type": "string"},
    "changed": {"type": "boolean"},
    "dry_run": {"type": "boolean"},
    "cleared": {"type": "boolean"},
    "message": {"type": "string"},
    "plan": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["schema", "wait_for", "then", "head_sha", "github_url", "created_at", "note"],
          "properties": {
            "schema": {"const": "dev-pack-human-plan.v1"},
            "wait_for": {"enum": ["ci", "author"]},
            "then": {"enum": ["approve", "request_changes", "re_review", "inspect"]},
            "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
            "github_url": {"type": ["string", "null"]},
            "created_at": {"type": "string", "format": "date-time"},
            "note": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
