{
  "diagnosis": {
    "match": "subsystems named by the symptom, trace, or failing path",
    "consumers": ["assets/prompts/bug-worker.prompt.template.md"]
  },
  "design": {
    "match": "paths and subsystems the proposed design expects to affect",
    "consumers": ["assets/prompts/feature-dev.prompt.template.md"]
  },
  "implementation": {
    "match": "planned and actually changed paths",
    "consumers": ["assets/prompts/feature-dev.prompt.template.md", "assets/prompts/bug-worker.prompt.template.md"]
  },
  "change-review": {
    "match": "the immutable base-to-head changed paths",
    "consumers": ["agents/pr-review-synthesizer/prompt.template.md", "agents/pr-chat/prompt.template.md", "assets/prompts/bug-worker.prompt.template.md"]
  },
  "settle": {
    "match": "changed paths implicated by the disputed keystone",
    "consumers": ["agents/pr-review-synthesizer/prompt.template.md"]
  }
}
